{
  "name": "@codebase-engineer/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codebase Engineer backend API (Fastify + TypeScript + SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy:migrations && npm run copy:frontend",
    "copy:migrations": "node scripts/copy-migrations.mjs",
    "copy:frontend": "node scripts/copy-frontend.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ignore": "^7.0.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

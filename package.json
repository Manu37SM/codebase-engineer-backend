{
  "name": "@codebase-engineer/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codebase Engineer backend API (Fastify + TypeScript + SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy:migrations && npm run copy:frontend",
    "copy:migrations": "node scripts/copy-migrations.mjs",
    "copy:frontend": "node scripts/copy-frontend.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.3.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.14.15",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}

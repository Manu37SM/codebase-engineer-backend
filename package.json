{
  "name": "@codebase-engineer/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codebase Engineer backend API (Fastify + TypeScript + SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy:migrations",
    "copy:migrations": "node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
